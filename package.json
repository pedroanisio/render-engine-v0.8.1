{
  "name": "scene-render-js",
  "version": "0.8.1",
  "description": "Scene renderer with codec-aware exports, HDR and alpha, operational safeguards and conformance evidence",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.8"
  },
  "bin": {
    "scene-render": "bin/scene-render.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "codegen": "node scripts/codegen.js",
    "oracle": "node scripts/oracle.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/generated/**' --test-coverage-branches=90 --test-coverage-lines=90 --test-coverage-functions=90 'test/**/*.test.js'",
    "check": "npm run typecheck && npm test",
    "certify": "node scripts/certify.js"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-web": "0.80.0",
    "@napi-rs/canvas": "1.0.9",
    "@resvg/resvg-js": "2.6.2",
    "@woff2/woff2-rs": "1.0.1",
    "acorn": "8.18.0",
    "assimpjs": "0.0.10",
    "bidi-js": "1.1.0",
    "bwip-js": "4.11.4",
    "earcut": "3.0.2",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "hyphenation.en-us": "0.2.1",
    "hyphenation.pt": "0.2.1",
    "hypher": "0.2.5",
    "mathjax-full": "3.2.1",
    "opentype.js": "1.3.4",
    "planck": "1.4.2",
    "pngjs": "7.0.0",
    "saxes": "6.0.0",
    "sharp": "0.35.4",
    "svg-path-properties": "2.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-color-emoji": "5.3.2",
    "@types/earcut": "3.0.0",
    "@types/node": "22.20.4",
    "@types/opentype.js": "1.3.10",
    "@types/pngjs": "6.0.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
